# =====================================================
# TELEGRAM
# =====================================================

# Token dari @BotFather
TELEGRAM_TOKEN=

# Telegram ID kamu (admin). Cek via @userinfobot
ADMIN_TELEGRAM_ID=

# =====================================================
# AI — KENARI
# =====================================================

# API key dari kenari.id
KENARI_API_KEY=

# =====================================================
# SUPABASE
# =====================================================

SUPABASE_URL=
SUPABASE_KEY=

# =====================================================
# MINI APP
# =====================================================

# URL publik Mini App (digunakan sebagai tombol di bot)
# Contoh: https://taqrir.namadomain.com
MINI_APP_URL=

# Port lokal untuk server Express (Mini App + upload)
# Default: 3000
UPLOAD_PORT=3000

# =====================================================
# WEBHOOK (opsional — isi untuk production di VPS)
# Kosongkan untuk mode polling (development lokal)
# =====================================================

# Domain publik yang mengarah ke server ini via Cloudflare tunnel
# Contoh: taqrir.namadomain.com  (tanpa https://)
WEBHOOK_DOMAIN=

# =====================================================
# YT-DLP (opsional)
# =====================================================

# Path ke binary yt-dlp. Default: 'yt-dlp' (jika sudah di PATH)
# YTDLP_PATH=/usr/local/bin/yt-dlp
